# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/revision-study-reminder
# For MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/revision-study-reminder

# S3 Storage - AWS (Production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=revision-study-content

# S3 Storage - MinIO (Local Development)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# LLM API - Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# URL Extraction
URL_EXTRACTOR=jina  # "tavily" | "jina" | "exa"
TAVILY_API_KEY=your_tavily_api_key
JINA_API_KEY=your_jina_api_key
EXA_API_KEY=your_exa_api_key

# Lambda Configuration (AWS only)
URL_PROCESSOR_LAMBDA_NAME=url-processor

# Server Configuration
PORT=3000
NODE_ENV=development

# AWS Cognito Authentication
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_client_id_here

# Development/Testing Options
# Set SKIP_AUTH=true to bypass authentication in development
SKIP_AUTH=false
TEST_USER_ID=test-user-123
