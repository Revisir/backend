# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/revision-study-reminder
# For MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/revision-study-reminder

# S3 Storage - AWS (Production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=revision-study-content

# Object storage backend: "seaweedfs" for the self-hosted S3 gateway,
# anything else for real AWS S3. This, not NODE_ENV, is the switch.
BUCKET_TYPE=seaweedfs

# S3 Storage - SeaweedFS (Local Development)
S3_ENDPOINT=localhost
S3_PORT=8333
S3_USE_SSL=false
S3_ACCESS_KEY=seaweedfsadmin
S3_SECRET_KEY=seaweedfssecret
# Browser-facing origin for presigned URLs. Whatever serves it must send
# the internal Host upstream (see ../.github/Caddyfile) or the signature
# will not verify. Leave empty to hand out the internal origin as-is.
S3_PUBLIC_URL=
# LLM API - Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# URL Extraction
URL_EXTRACTOR=jina  # "tavily" | "jina" | "exa" | "firecrawl"
TAVILY_API_KEY=your_tavily_api_key
JINA_API_KEY=your_jina_api_key
EXA_API_KEY=your_exa_api_key

# Firecrawl (cloud or self-hosted)
FIRECRAWL_API_KEY=your_firecrawl_api_key
FIRECRAWL_API_URL=  # Set for self-hosted, e.g. http://localhost:3002

# Lambda Configuration (AWS only)
URL_PROCESSOR_LAMBDA_NAME=url-processor

# Server Configuration
PORT=3000
NODE_ENV=development

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=reviser-api
# OTEL_DEBUG=true  # Uncomment for verbose OTel diagnostics



# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Development/Testing Options
# Set SKIP_AUTH=true to bypass authentication in development
SKIP_AUTH=false
TEST_USER_ID=test-user-123
